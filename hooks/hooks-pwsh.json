{
  "description": "OceanBus Console hooks — PowerShell version for Windows without Git Bash",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$P=$env:CLAUDE_PLUGIN_ROOT; if(-not $P){$P=$env:PLUGIN_ROOT}; Start-Process -NoNewWindow -FilePath 'node' -ArgumentList \"`\"$P/scripts/agent-daemon.cjs`\"\" ; echo '{\"continue\":true,\"suppressOutput\":true}'",
            "timeout": 30
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "$P=$env:CLAUDE_PLUGIN_ROOT; if(-not $P){$P=$env:PLUGIN_ROOT}; Start-Sleep 3; & node \"$P/scripts/agent-daemon.cjs\" hook-status 2>$null; echo '{\"continue\":true,\"suppressOutput\":false}'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "$P=$env:CLAUDE_PLUGIN_ROOT; if(-not $P){$P=$env:PLUGIN_ROOT}; & node \"$P/scripts/agent-daemon.cjs\" stop 2>$null; echo '{\"continue\":true,\"suppressOutput\":true}'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
